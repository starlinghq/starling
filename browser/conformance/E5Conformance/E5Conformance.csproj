<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Runs the e5 browser packages (Starlings.Models.E5.Browser on Starlings.Runtime.OnnxWeb) on the protected fixtures
    in headless Chromium; ../run_conformance.py drives it and ../evaluate_e5_browser.py checks the results against the
    committed browser tolerances. Publish: dotnet publish -c Release [-p:RunAOTCompilation=true].
  -->
  <PropertyGroup>
    <RootNamespace>Starlings.E5Conformance</RootNamespace>
    <AssemblyName>E5Conformance</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Trim analysis on for this app's code; framework assemblies report one collapsed warning each (Blazor's own). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <!-- IL2104 is the collapsed per-assembly warning of Microsoft.AspNetCore.Components and Microsoft.JSInterop (10.0.12). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../ai-dotnet/src/Starlings.Models.E5.Browser/Starlings.Models.E5.Browser.csproj" />
    <ProjectReference Include="../../../ai-dotnet/src/Starlings.Runtime.OnnxWeb.WebGpu/Starlings.Runtime.OnnxWeb.WebGpu.csproj" />
  </ItemGroup>

</Project>
