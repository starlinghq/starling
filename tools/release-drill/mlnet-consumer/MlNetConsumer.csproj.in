<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway ML.NET consumer for tools/release-drill-ai.sh. The script copies this file outside the repository and
    replaces @VERSION@. Its only dependencies are the two ML.NET adapter packages from the local feed (which bring the
    model packages and Microsoft.ML) and the CPU natives of ONNX Runtime from nuget.org.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Starlings.Models.E5.MLNet" Version="[@VERSION@]" />
    <PackageReference Include="Starlings.Models.EmbeddingGemma2.MLNet" Version="[@VERSION@]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
