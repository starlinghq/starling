<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway Starlings.Models.Bert consumer for tools/release-drill-ai.sh. The script copies this file outside the
    repository and replaces @VERSION@. Its only dependencies are Starlings.Models.Bert from the local feed (which brings
    Starlings.Runtime.Onnx, Starlings.Acquisition and Starlings.Tokenizers) and the CPU natives of ONNX Runtime from
    nuget.org.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Starlings.Models.Bert" Version="[@VERSION@]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
