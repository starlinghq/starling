        48,
        320
      ],
      "input": "x",
      "max_width": 3200,
      "output": "fetch_name_0"
    },
    "recognizer_model": "PP-OCRv5_mobile_rec"
  },
  "evaluation": {
    "policy": {
      "box_flip_margin": 0.01,
