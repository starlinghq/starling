  <!-- Unit tests for the benchmark harness logic: whether a run's results are valid (P-008), the shared timing core and the G5 workload files. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Starlings.Benchmarks.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Core/QualityGate.cs" Link="Core/QualityGate.cs" />
    <Compile Include="../Core/HarnessCore.cs" Link="Core/HarnessCore.cs" />
    <Compile Include="../Core/WorkloadSpec.cs" Link="Core/WorkloadSpec.cs" />
  </ItemGroup>

</Project>
