{
  "description": "EmbeddingGemma 2 workloads (G5, plan section 11). Text requests name rows of model-pipeline/protected/embeddinggemma-2/onnx-fp32-cpu/embeddings.jsonl by key (id, or id@prompt); image requests name rows of model-pipeline/protected/embeddinggemma-2/image-fp32-cpu/image-embeddings.jsonl. Every output is compared with that row's reference embedding. 'synthetic' text workloads take the first N words of a fixture text to fill the gap between the short and the 1,500-token rows; they have no upstream reference and are compared with the same text embedded alone at load (padded-batch consistency, not fidelity). 'preprocess-only' times the image processor alone and checks the pixel values' SHA-256 against the fixture digest. Video is not covered: the video fixtures need FFmpeg to decode.",
  "warmup_calls": 3,
  "cold": { "text": ["ascii-sentence@query"], "image": ["photo-chelsea"] },
  "workloads": [
    { "name": "short-b1", "path": "text", "input": "short", "samples": 100,
      "requests": [["ascii-sentence@query"], ["arabic"], ["korean@document"], ["ascii-punct"], ["nfkc-compat@query"], ["emoji-zwj"]] },
    { "name": "short-b8", "path": "text", "input": "short", "batch": 8, "samples": 40,
      "requests": [["ascii-sentence@query", "arabic", "korean@document", "ascii-punct", "nfkc-compat@query", "emoji-zwj", "digits@document", "chinese"]] },
    { "name": "short-b16", "path": "text", "input": "short", "batch": 16, "samples": 20,
      "requests": [["ascii-sentence@query", "arabic", "korean@document", "ascii-punct", "nfkc-compat@query", "emoji-zwj", "digits@document", "chinese",
                    "japanese@query", "hebrew", "thai@document", "cyrillic-greek", "devanagari@query", "e5-passage-prefix", "repeated-char@document", "math-alnum-astral"]] },
    { "name": "words100-b1", "path": "text", "input": "medium", "samples": 30,
      "synthetic": { "row": "long-english", "words": 100 } },
    { "name": "words400-b1", "path": "text", "input": "long", "samples": 15,
      "synthetic": { "row": "long-english", "words": 400 } },
    { "name": "long-b1", "path": "text", "input": "long", "samples": 8,
      "requests": [["long-english"], ["long-mixed@query"]] },
    { "name": "long-b4", "path": "text", "input": "long", "batch": 4, "samples": 4,
      "requests": [["long-english", "long-english@document", "long-mixed", "long-mixed@query"]] },
    { "name": "photo-b1", "path": "image", "input": "photo", "samples": 20,
      "requests": [["photo-chelsea"], ["photo-coffee"], ["photo-camera"]] },
    { "name": "tiny-b1", "path": "image", "input": "tiny", "samples": 20,
      "requests": [["size-1x1"], ["size-tiny-8x6"]] },
    { "name": "huge-b1", "path": "image", "input": "4000x3000", "samples": 10,
      "requests": [["size-huge-4000x3000"]] },
    { "name": "photo-b4", "path": "image", "input": "photo", "batch": 4, "samples": 6,
      "requests": [["photo-chelsea", "photo-coffee", "photo-camera", "photo-rocket"]] },
    { "name": "two-images-interleaved", "path": "image", "input": "text+2 images", "samples": 8,
      "requests": [["mm-two-images"]] },
    { "name": "preprocess-only", "path": "image", "input": "photo", "samples": 50, "preprocess_only": true,
      "requests": [["photo-chelsea"], ["photo-coffee"], ["size-huge-4000x3000"]] }
  ]
}
