<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CUDA build of the Qwen3.5 generation harness (Linux x64), same sources as ../Starlings.Benchmarks.Qwen35Harness:
    profiles ortgenai-fp32x-cuda and, with variant fp16x, ortgenai-fp16x-cuda (provider cuda). Local only: not in
    AI.slnx, so CI does not restore the GPU package. Microsoft.ML.OnnxRuntimeGenAI.Cuda brings Microsoft.ML.OnnxRuntime.Gpu
    1.30.0; the CUDA 13 runtime and cuBLAS are not in the package (run-g5-matched.sh loads those of the Python runner's
    nvidia-* wheels); see docs/benchmarks/PROTOCOL.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Starlings.Benchmarks</RootNamespace>
    <DefineConstants>$(DefineConstants);ORT_CUDA</DefineConstants>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Starlings.Benchmarks.Qwen35Harness/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../tests/Shared/Qwen35/Qwen35TestAssets.cs" Link="Shared/Qwen35TestAssets.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.Qwen35/Starlings.Models.Qwen35.csproj" />
    <!-- The shared core records ONNX Runtime session settings types; no ONNX Runtime session is created here. -->
    <ProjectReference Include="../../src/Starlings.Runtime.Onnx/Starlings.Runtime.Onnx.csproj" />
  </ItemGroup>

</Project>
