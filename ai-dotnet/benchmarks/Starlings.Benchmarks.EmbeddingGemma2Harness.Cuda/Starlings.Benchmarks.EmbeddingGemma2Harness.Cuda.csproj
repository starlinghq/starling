<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CUDA build of the EmbeddingGemma 2 workload harness (Linux x64), same sources as
    ../Starlings.Benchmarks.EmbeddingGemma2Harness: profiles onnx-fp32-cuda and image-fp32-cuda (provider cuda).
    Local only: not in AI.slnx, so CI does not restore the GPU package. The CUDA 13 runtime and cuDNN 9 are not in the
    package (run-g5-matched.sh loads those of the Python runner's nvidia-* wheels); see docs/benchmarks/PROTOCOL.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Starlings.Benchmarks</RootNamespace>
    <DefineConstants>$(DefineConstants);ORT_CUDA</DefineConstants>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Starlings.Benchmarks.EmbeddingGemma2Harness/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../tests/Shared/EmbeddingGemma2/EmbeddingGemma2TestAssets.cs" Link="Shared/EmbeddingGemma2TestAssets.cs" />
    <Compile Include="../../tests/Shared/EmbeddingGemma2Images/EmbeddingGemma2ImageTestAssets.cs" Link="Shared/EmbeddingGemma2ImageTestAssets.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.EmbeddingGemma2/Starlings.Models.EmbeddingGemma2.csproj" />
    <ProjectReference Include="../../src/Starlings.Models.EmbeddingGemma2.Imaging.SkiaSharp/Starlings.Models.EmbeddingGemma2.Imaging.SkiaSharp.csproj" />
  </ItemGroup>

</Project>
