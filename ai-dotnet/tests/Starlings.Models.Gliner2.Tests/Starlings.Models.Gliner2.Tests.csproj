<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- CPU native runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Registry/*.cs" Link="Shared/Registry/%(Filename)%(Extension)" />
    <Compile Include="../Shared/CapabilityRecords/*.cs" Link="Shared/CapabilityRecords/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Gliner2/*.cs" Link="Shared/Gliner2/%(Filename)%(Extension)" />
    <Compile Include="../Shared/TestModels/*.cs" Link="Shared/TestModels/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Operational/*.cs" Link="Shared/Operational/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Scheduling/*.cs" Link="Shared/Scheduling/%(Filename)%(Extension)" />
    <None Include="Data/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.Gliner2/Starlings.Models.Gliner2.csproj" />
  </ItemGroup>

</Project>
