<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- CPU native runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Data" />
    <Compile Include="../Shared/Kev/*.cs" Link="Shared/Kev/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Registry/*.cs" Link="Shared/Registry/%(Filename)%(Extension)" />
    <Compile Include="../Shared/CapabilityRecords/*.cs" Link="Shared/CapabilityRecords/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.Kev.Onnx/Starlings.Models.Kev.Onnx.csproj" />
  </ItemGroup>

</Project>
