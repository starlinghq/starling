<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Local-only GLiNER2 CUDA tests (Linux x64). Not part of AI.slnx, so CI does not restore the GPU package.
    Opt in with STARLING_CUDA_TESTS=1, CUDA_DEVICE_ORDER=PCI_BUS_ID and an explicit CUDA_VISIBLE_DEVICES;
    see ai-dotnet/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- CUDA native runtime (includes the CPU provider). The CUDA 13 runtime and cuDNN 9 are not in the package. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Gliner2/*.cs" Link="Shared/Gliner2/%(Filename)%(Extension)" />
    <Compile Include="../Shared/Cuda/*.cs" Link="Shared/Cuda/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.Gliner2/Starlings.Models.Gliner2.csproj" />
  </ItemGroup>

</Project>
