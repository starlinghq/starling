<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    ONNX Runtime Web for Starlings models in the browser (Blazor WebAssembly or any .NET browser-wasm app). A Razor
    class library only for its static web assets: no Razor components and no ASP.NET Core framework reference, so a
    standalone Blazor WebAssembly app can reference it. The C# side calls the JavaScript module
    wwwroot/starlings-onnxweb.js through [JSImport]; onnxruntime-web's WASM-only bundle (1.30.0, npm pin in
    ../Shared/OnnxWeb) is served under _content/Starlings.Runtime.OnnxWeb/ort/. WebGPU is the voluntary adapter
    Starlings.Runtime.OnnxWeb.WebGpu.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- [JSImport] generated code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <Description>ONNX Runtime Web (onnxruntime-web 1.30.0, WASM backend) for Starlings models in .NET browser-wasm apps such as Blazor WebAssembly: model download with SHA-256 verification and Cache Storage, session creation and runs from C# through [JSImport]; model bytes never enter the .NET heap. Ships onnxruntime-web's WASM-only bundle as static web assets. WebGPU is the separate Starlings.Runtime.OnnxWeb.WebGpu package. WebAssembly has no support badge. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>onnxruntime-web;onnx;wasm;webassembly;blazor;browser;inference;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WASM-only bundle: the ES module, its Emscripten loader and the SIMD + threads binary (14.2 MB, 2.3 MB brotli). -->
    <StarlingsOrtWebFile Include="ort.wasm.min.mjs" />
    <StarlingsOrtWebFile Include="ort-wasm-simd-threaded.mjs" />
    <StarlingsOrtWebFile Include="ort-wasm-simd-threaded.wasm" />
  </ItemGroup>

  <Import Project="../Shared/OnnxWeb/OrtWebAssets.targets" />

  <ItemGroup>
    <!-- One test project covers both browser packages (CoreCLR: everything except the [JSImport] calls). -->
    <InternalsVisibleTo Include="Starlings.Models.E5.Browser.Tests" />
  </ItemGroup>

</Project>
