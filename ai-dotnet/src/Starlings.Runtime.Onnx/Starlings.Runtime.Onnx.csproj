<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Trim, AOT and single-file analyzers on (warnings are errors); Native AOT evidence: docs/evidence/aot/. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>ONNX Runtime session ownership, execution-provider validation and diagnostics for Starlings models. References only the managed ONNX Runtime binding (exactly 1.30.0): the application adds one native package, Microsoft.ML.OnnxRuntime (CPU) or Microsoft.ML.OnnxRuntime.Gpu.Linux (CUDA). Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>onnxruntime;onnx;inference;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- Build-time native package check for every consumer, direct or transitive (README, "Native package check"). -->
    <None Include="buildTransitive/Starlings.Runtime.Onnx.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Container-aware default intra-op thread count (docs/evidence/cuda-soak-growth/). -->
    <Compile Include="../Shared/Threading/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Runtime.Onnx.Tests" />
    <!-- EncoderCore (packing, pooling, the chunk run) is shared by the text encoders; it is internal, not public API. The
         packages pin each other exactly, so the internal surface always comes from the same build. -->
    <InternalsVisibleTo Include="Starlings.Models.E5" />
    <InternalsVisibleTo Include="Starlings.Models.EmbeddingGemma2" />
    <InternalsVisibleTo Include="Starlings.Models.Bert" />
    <InternalsVisibleTo Include="Starlings.Models.Qwen3Embedding" />
  </ItemGroup>

</Project>
