<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Trim, AOT and single-file analyzers on (warnings are errors); Native AOT evidence: docs/evidence/aot/. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>intfloat/multilingual-e5-small (revision 614241f6) sentence embeddings on ONNX Runtime, from text through the owned tokenizer (Starlings.Tokenizers: no Microsoft.ML.Tokenizers, no native tokenizer) or from token ids: right padding, mean pooling, L2 normalization. Ships the model's asset lock, not the weights; acquire them explicitly. Profiles multilingual-e5-small/onnx-fp32-cpu and onnx-fp32-cuda. The application adds the ONNX Runtime native package. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>embeddings;e5;multilingual-e5-small;sentence-embeddings;onnxruntime;semantic-search</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Runtime.Onnx/Starlings.Runtime.Onnx.csproj" />
    <!-- CapabilityStatus, ModelProfileCapabilities, ITextEmbedder and the InputTooLongException base (no ONNX Runtime dependency). -->
    <ProjectReference Include="../Starlings.Models.Abstractions/Starlings.Models.Abstractions.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
  </ItemGroup>

  <!-- Asset lock and explicit acquisition of the pinned model files (P-009). BCL only, no further dependencies. -->
  <ItemGroup>
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Models.E5.Tests" />
    <!-- The browser encoder reuses the padding, pooling, chunk planning and input checks, so both paths compute the same numbers. -->
    <InternalsVisibleTo Include="Starlings.Models.E5.Browser" />
    <InternalsVisibleTo Include="Starlings.Models.E5.Browser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Length-aware chunk planning shared by the explicit-batch encoders (internal). -->
    <Compile Include="../Shared/Batching/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
