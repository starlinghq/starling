<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>MODEL LICENSE: LFM Open License v1.0, not MIT or Apache-2.0. Commercial use of LFM3 is licensed only to entities below USD 10 million annual revenue (section 5); read LICENSE.txt in the package before use. LiquidAI/LFM3-1.7B text generation on ONNX Runtime (Liquid's ONNX export LiquidAI/LFM3-1.7B-ONNX, revision c680759a): the LFM3 chat template for text turns, a managed greedy decode loop over the export's step graph with its convolution and attention caches, and the owned tokenizer (Starlings.Tokenizers profile lfm3-bpe-chat). Ships the asset lock, not the weights; acquire them explicitly. The application adds the ONNX Runtime native package. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>lfm3;liquid;llm;chat;onnxruntime;text-generation;lfm-open-license</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The model's license governs: the package carries the LFM Open License v1.0 as its license file (with the split
         between the ported template and the MIT OR Apache-2.0 rest of the code) and asks for acceptance on install,
         instead of the repository-wide license expression. -->
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Runtime.Onnx/Starlings.Runtime.Onnx.csproj" />
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
    <!-- ModelProfileCapabilities: the generated capability records (ProfileCapabilities.g.cs). -->
    <ProjectReference Include="../Starlings.Models.Abstractions/Starlings.Models.Abstractions.csproj" />
    <ProjectReference Include="../Starlings.Generation.Abstractions/Starlings.Generation.Abstractions.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Models.Lfm3.Tests" />
    <!-- The source-only intervention companion (experimental): loads derived graphs and passes the strength input. -->
    <InternalsVisibleTo Include="Starlings.Models.Lfm3.Interventions" />
    <InternalsVisibleTo Include="Starlings.Models.Lfm3.Interventions.Tests" />
  </ItemGroup>

</Project>
