<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- The types keep the namespace of the model definition package, so code moves by changing the package reference. -->
    <RootNamespace>Starlings.Models.QwenChat</RootNamespace>
    <Description>Qwen/Qwen3-0.6B (revision c1899de2, thinking disabled) and Qwen/Qwen2.5-0.5B-Instruct (revision 7ae55760) text chat generation in-process on ONNX Runtime GenAI 0.17.1: QwenChatModel over the model definitions Starlings.Models.QwenChat (the pinned chat templates rendered in C#, the tool-call parser, prompt ids from the owned tokenizer Starlings.Tokenizers: no Microsoft.ML.Tokenizers, no GenAI tokenizer) and Starling's decode loop (greedy, stop tokens and strings, streaming, cancellation between steps, usage). Ships no weights: QwenChatModelAssets downloads the profile's bundle explicitly from Starling's public Hugging Face hosting (or it is built locally from the pinned original), and Load verifies every file against the profile's digests. Profiles qwen3-0.6b/ortgenai-fp32-cpu and qwen2.5-0.5b-instruct/ortgenai-fp32-cpu, Linux x64. The application adds Microsoft.ML.OnnxRuntimeGenAI. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>llm;chat;qwen;qwen3;qwen2.5;text-generation;onnxruntime-genai;streaming;tool-calling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <ProjectReference Include="../Starlings.Models.QwenChat/Starlings.Models.QwenChat.csproj" />
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
    <!-- ModelProfileCapabilities: the generated capability records (ProfileCapabilities.g.cs). -->
    <ProjectReference Include="../Starlings.Models.Abstractions/Starlings.Models.Abstractions.csproj" />
    <ProjectReference Include="../Starlings.Generation.OnnxGenAI/Starlings.Generation.OnnxGenAI.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
  </ItemGroup>
</Project>
