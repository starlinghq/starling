<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Preview. Experimental. ML.NET estimator and transformer for the EmbeddingGemma 2 text embedder (Starlings.Models.EmbeddingGemma2): a text column to a fixed-size Vector&lt;Single, 768/512/256/128&gt; embedding column and an optional token-count column, one inference per row however many getters are requested, explicit prompts and optional look-ahead batching. Text only. Pipeline composition only: saving the transformer is unsupported (it throws); the model is resolved from its asset lock at run time. Deployments must adhere to the Gemma Prohibited Use Policy.</Description>
    <PackageTags>embeddings;embeddinggemma;embeddinggemma-2;ml.net;mlnet;idataview;onnxruntime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- IEstimator, ITransformer, IDataView, MLContext. Brings no tokenizer package (checked in CI and by the release drill). -->
    <PackageReference Include="Microsoft.ML" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Models.EmbeddingGemma2/Starlings.Models.EmbeddingGemma2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Models.EmbeddingGemma2.MLNet.Tests" />
  </ItemGroup>

</Project>
