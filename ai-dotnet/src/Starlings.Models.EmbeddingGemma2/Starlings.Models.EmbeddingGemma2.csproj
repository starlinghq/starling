<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Trim, AOT and single-file analyzers on (warnings are errors); Native AOT evidence: docs/evidence/aot/. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Function pointers into the CUDA driver for the opt-in free-memory probe (EmbeddingGemma2AutoBatchLimits). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>google/embeddinggemma-2 (revision 914f7f89) text and image embeddings on ONNX Runtime, from text through the owned tokenizer (Starlings.Tokenizers, profile gemma-bpe-embeddinggemma2: no Microsoft.ML.Tokenizers, no native tokenizer) or from token ids: right-padded batching, mean pooling over every token including the prompt, L2 normalization, Matryoshka sizes 768/512/256/128, explicit named prompts (never added silently), inputs above 8,192 tokens rejected. Images: image-only and interleaved text-and-image embeddings from already-decoded RGB (no native dependency; the upstream processor restated bit for bit, including PyTorch's uint8 antialiased bicubic resize), default budget 280 soft tokens, vision graph plus multimodal text graph; text-only input keeps the released text graph. Videos: video-only and interleaved text/image/video embeddings from decoded RGB frames at the checkpoint settings (1 fps, at most 32 frames, 140 soft tokens per frame, no timestamps; upstream sampling restated exactly; frames without timing rejected unless opted in), same graphs; decoding is the optional FFmpeg adapter. Audio is not supported. Ships the asset locks (Starling's ONNX graphs and the pinned tokenizer.json), not the weights; acquire them explicitly. Profiles embeddinggemma-2/onnx-fp32-cpu, onnx-fp32-cuda, image-fp32-cpu, image-fp32-cuda, video-fp32-cpu and video-fp32-cuda (Linux x64). Apache-2.0 weights; deployments must adhere to the Gemma Prohibited Use Policy. The application adds the ONNX Runtime native package. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>embeddings;embeddinggemma;embeddinggemma-2;gemma;sentence-embeddings;matryoshka;onnxruntime;semantic-search</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Runtime.Onnx/Starlings.Runtime.Onnx.csproj" />
    <!-- CapabilityStatus, ModelProfileCapabilities, ITextEmbedder and the InputTooLongException base (no ONNX Runtime dependency). -->
    <ProjectReference Include="../Starlings.Models.Abstractions/Starlings.Models.Abstractions.csproj" />
    <!-- Asset lock and explicit acquisition of the pinned files (P-009). BCL only. -->
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Models.EmbeddingGemma2.Tests" />
    <InternalsVisibleTo Include="Starlings.Models.EmbeddingGemma2.Tests.Cuda" />
    <!-- The fidelity tool dumps soft tokens and token embeddings for the staged evaluator. -->
    <InternalsVisibleTo Include="Starlings.Fidelity.Tool" />
  </ItemGroup>

  <ItemGroup>
    <!-- Length-aware chunk planning shared by the explicit-batch encoders (internal). -->
    <Compile Include="../Shared/Batching/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
