<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Trim, AOT and single-file analyzers on (warnings are errors); Native AOT evidence: docs/evidence/aot/. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Preview. Microsoft.Extensions.AI IChatClient over the Qwen/Qwen3.5-0.8B chat model (Starlings.Models.Qwen35): system, user and assistant text messages; tool calling (AIFunction tools, FunctionCallContent and FunctionResultContent, ToolMode Auto and None, works with UseFunctionInvocation); streaming with UTF-8-safe text deltas that reassemble the completed response; finish reasons and usage (stop token excluded); max output tokens, stop sequences, seeded sampling and the thinking switch; unsupported options and non-text content rejected; cancellation between prefill chunks and decode steps on a dedicated worker thread; model metadata and DI registration.</Description>
    <PackageTags>llm;chat;qwen;qwen3.5;microsoft.extensions.ai;ichatclient;streaming;onnxruntime-genai;tool-calling;function-calling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/starlinghq/starling/blob/main/ai-dotnet/README.md#microsoftextensionsai-chat-client-p-017</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!--
      10.10.1, the version the e5 adapter uses. Microsoft.ML.OnnxRuntimeGenAI.Managed 0.17.1 (through Models.Qwen35)
      depends on Microsoft.Extensions.AI.Abstractions >= 9.8.0 for its own IChatClient, which no Starling code
      uses; this direct reference lifts the whole graph to 10.10.1 (NuGet's direct-dependency-wins rule; no downgrade).
    -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Models.Qwen35/Starlings.Models.Qwen35.csproj" />
  </ItemGroup>

</Project>
