<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Trim, AOT and single-file analyzers on (warnings are errors); Native AOT evidence: docs/evidence/aot/. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>fastino/gliner2-base-v1 (revision f9634218, GLiNER2 2.0.0) English entity extraction with labels and a threshold on ONNX Runtime: GLiNER2's Python text semantics (normalization, word splitter, lower-casing) and schema prefix through the owned tokenizer (Starlings.Tokenizers: no Microsoft.ML.Tokenizers, no native tokenizer), one ONNX graph, GLiNER2's span decoding, offsets into the original text. Ships the asset lock, not the weights; acquire them explicitly. Profiles gliner2-base-v1/onnx-fp32-cpu and onnx-fp32-cuda. The application adds the ONNX Runtime native package. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>ner;named-entity-recognition;entity-extraction;gliner;gliner2;zero-shot;onnxruntime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/starlinghq/starling/blob/main/ai-dotnet/README.md#gliner2-entity-extraction-p-015</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Runtime.Onnx/Starlings.Runtime.Onnx.csproj" />
    <!-- CapabilityStatus, ModelProfileCapabilities, ITextEmbedder and the InputTooLongException base (no ONNX Runtime dependency). -->
    <ProjectReference Include="../Starlings.Models.Abstractions/Starlings.Models.Abstractions.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
    <!-- Asset lock and explicit acquisition of the pinned files (P-009). BCL only. -->
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Models.Gliner2.Tests" />
    <InternalsVisibleTo Include="Starlings.Models.Gliner2.Tests.Cuda" />
    <!-- Upstream-format spans (normalized-text offsets) for the stage results dump. -->
    <InternalsVisibleTo Include="Starlings.Fidelity.Tool" />
    <!-- The same upstream-format spans for the benchmark harness's per-series quality check (rules of the parity tests). -->
    <InternalsVisibleTo Include="Starlings.Benchmarks.Gliner2Harness" />
    <InternalsVisibleTo Include="Starlings.Benchmarks.Gliner2Harness.Cuda" />
  </ItemGroup>

  <ItemGroup>
    <!-- Length-aware chunk planning shared by the explicit-batch encoders (internal). -->
    <Compile Include="../Shared/Batching/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
