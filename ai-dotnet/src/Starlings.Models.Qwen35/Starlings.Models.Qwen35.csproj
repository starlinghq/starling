<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Trim, AOT and single-file analyzers on (warnings are errors); Native AOT evidence: docs/evidence/aot/. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Qwen/Qwen3.5-0.8B (revision 2fc06364) model definition without a runtime: the pinned chat template rendered in C# for text and tool-calling conversations (system, user, assistant and tool messages, tool definitions and calls, thinking switch; images rejected), a parser for the template's tool-call format (whole or streamed), the llguidance tool-call grammar builder, per-request chat options, the checkpoint's ModelProfile (repository, revision, owned tokenizer profile qwen35-bpe-chat, template digest, end-of-sequence ids, decoder shape) and the asset lock of the Hub checkpoint itself (safetensors, config, tokenizer, template). No ONNX Runtime dependency. To run the model in-process on ONNX Runtime GenAI, reference Starlings.Models.Qwen35.OnnxGenAI. Maturity is per model profile (Stable, Preview or Experimental): see the README, generated from the model registry.</Description>
    <PackageTags>llm;chat;qwen;qwen3.5;chat-template;tool-calling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/starlinghq/starling/blob/main/ai-dotnet/README.md#generation-backend-and-pilot-llm-p-016</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- Qwen35Checkpoint.Lock as a JSON lock (schema_version 2) for tools outside .NET; a test keeps the two equal. -->
    <None Include="locks/qwen3.5-0.8b.checkpoint.lock.json" Pack="true" PackagePath="locks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starlings.Generation.Abstractions/Starlings.Generation.Abstractions.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
    <!-- ModelAssetLock of the Hub checkpoint (BCL only). -->
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ONNX Runtime GenAI package maps the chat options per provider (ToGenerationOptionsCore). -->
    <InternalsVisibleTo Include="Starlings.Models.Qwen35.OnnxGenAI" />
    <InternalsVisibleTo Include="Starlings.Models.Qwen35.Tests" />
    <InternalsVisibleTo Include="Starlings.Models.Qwen35.Tests.Cuda" />
    <!-- Scripted sequences under the Extensions.AI adapter (CI tests without the model). -->
    <InternalsVisibleTo Include="Starlings.Models.Qwen35.Extensions.AI.Tests" />
    <!-- Step-0 logits for the fidelity dump. -->
    <InternalsVisibleTo Include="Starlings.Qwen35.Fidelity" />
  </ItemGroup>

</Project>
