<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Experimental pinned BERT text embeddings and paired-input reranking on ONNX Runtime CPU, with owned WordPiece tokenization. MiniLM masked mean pooling, BGE CLS pooling, nomic-embed-text-v1.5 mean pooling (768 wide, not normalized), and MS MARCO scalar logits have separate typed APIs. No model weights are bundled.</Description>
    <PackageTags>bert;embeddings;reranking;onnxruntime;wordpiece</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <ProjectReference Include="../Starlings.Runtime.Onnx/Starlings.Runtime.Onnx.csproj" />
    <ProjectReference Include="../Starlings.Acquisition/Starlings.Acquisition.csproj" />
    <PackageReference Include="Starlings.Tokenizers" />
    <InternalsVisibleTo Include="Starlings.Models.Bert.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Length-aware chunk planning shared by the explicit-batch encoders (internal). -->
    <Compile Include="../Shared/Batching/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
