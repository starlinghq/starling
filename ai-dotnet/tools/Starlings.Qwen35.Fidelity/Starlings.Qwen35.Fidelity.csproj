<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pilot LLM fidelity runner (P-016): runs Starlings.Models.Qwen35 on prompts-v1 with the reference prompt
    ids and writes results in the shared format of model-pipeline/reference/generation/compare.py, plus the semantics
    checks of plan 10.1. Applies no thresholds. Not packed.

    -p:UseCuda=true swaps the CPU native package for the CUDA one (both ship libonnxruntime-genai under the same file
    name); that variant has its own lock file and is built locally only. CI builds the CPU variant (AI.slnx).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NuGetLockFilePath Condition="'$(UseCuda)' == 'true'">packages.cuda.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCuda)' != 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCuda)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.Qwen35/Starlings.Models.Qwen35.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entry-point wrapper: an escaping exception gives "error:" and exit code 70, not an abort and core dump. -->
    <Compile Include="../Shared/ToolMain.cs" Link="Shared/ToolMain.cs" />
  </ItemGroup>

</Project>
