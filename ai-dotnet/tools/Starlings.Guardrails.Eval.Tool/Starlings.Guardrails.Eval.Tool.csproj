<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures guards on the labelled input sets in data/ (dev.jsonl for tuning, heldout.jsonl for reported numbers). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Models.Kev.Guardrails/Starlings.Models.Kev.Guardrails.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="data/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- Entry-point wrapper: an escaping exception gives "error:" and exit code 70, not an abort and core dump. -->
    <Compile Include="../Shared/ToolMain.cs" Link="Shared/ToolMain.cs" />
  </ItemGroup>

</Project>
