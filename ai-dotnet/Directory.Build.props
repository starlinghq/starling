<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      The ai-dotnet packages (Runtime.Onnx, Acquisition, Models.E5, Models.E5.Extensions.AI, Models.E5.MLNet) share one version and
      release together from one commit (P-010). Scheme (docs/kickoff.md, "ai-dotnet package versions and maturity"): SemVer 2,
      0.MINOR.PATCH, with 0.MINOR.PATCH-preview.N for candidates before a release; a 0.x major keeps the API-stability signal
      honest, and maturity (Experimental, Preview, Stable) is per model profile in each README, not a package label. The next
      version is 0.2.0, set by its release-candidate change. A published version is immutable. The tokenizer keeps its own version and cadence; Directory.Packages.props pins it exactly.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.6</VersionSuffix>
    <PackageReleaseNotes>https://github.com/starlinghq/starling/blob/main/docs/releases/ai-0.1.0-preview.5.md</PackageReleaseNotes>
  </PropertyGroup>
</Project>
