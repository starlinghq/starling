<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Streaming console chat with Qwen/Qwen3.5-0.8B from the published packages only: no project references, no
    repository paths. tools/release-drill-ai.sh copies this directory outside the checkout and restores it from a local
    feed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The release drill fails if this differs from the version it packs. -->
    <StarlingsVersion>0.3.0</StarlingsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Brings the model definition Starlings.Models.Qwen35, Starlings.Generation.OnnxGenAI and .Abstractions, .Acquisition
      and .Tokenizers at their pinned versions.
    -->
    <PackageReference Include="Starlings.Models.Qwen35.OnnxGenAI" Version="$(StarlingsVersion)" />
    <!-- The Microsoft.Extensions.AI IChatClient adapter, used with the chat-client option. -->
    <PackageReference Include="Starlings.Models.Qwen35.Extensions.AI" Version="$(StarlingsVersion)" />
    <!-- The application picks the ONNX Runtime GenAI natives (CPU here; Microsoft.ML.OnnxRuntimeGenAI.Cuda for CUDA). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" />
  </ItemGroup>

</Project>
