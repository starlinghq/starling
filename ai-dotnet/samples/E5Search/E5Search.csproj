<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Semantic search with multilingual-e5-small from the published packages only: no project references, no repository
    paths. tools/release-drill-ai.sh copies this directory outside the checkout and restores it from a local feed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The release drill fails if this differs from the version it packs. -->
    <StarlingsVersion>0.1.0-preview.5</StarlingsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings Starlings.Models.E5, .Runtime.Onnx, .Acquisition and .Tokenizers at their pinned versions. -->
    <PackageReference Include="Starlings.Models.E5.Extensions.AI" Version="$(StarlingsVersion)" />
    <!--
      The application picks the ONNX Runtime natives: Microsoft.ML.OnnxRuntime for CPU, or
      Microsoft.ML.OnnxRuntime.Gpu.Linux for CUDA on Linux x64 (then set OnnxSessionOptions.Provider = OnnxExecutionProvider.Cuda). Exactly one, same
      version as the managed binding the libraries reference (1.30.0).
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
