<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <StarlingsVersion>0.1.0-preview.6</StarlingsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Starlings.Models.EmbeddingGemma2.Extensions.AI" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Qwen35.Extensions.AI" Version="$(StarlingsVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" />
  </ItemGroup>
</Project>
