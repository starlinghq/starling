<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <StarlingsVersion>0.2.0</StarlingsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Brings Microsoft.ML (MLContext, trainers, IDataView) and Starlings.Models.E5. -->
    <PackageReference Include="Starlings.Models.E5.MLNet" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Gliner2" Version="$(StarlingsVersion)" />
    <!-- Exactly one ONNX Runtime native package, chosen by the application (CPU here). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="data/*.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
