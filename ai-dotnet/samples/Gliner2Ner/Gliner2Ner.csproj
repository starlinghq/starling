<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Entity extraction with fastino/gliner2-base-v1 from the published packages only: no project references, no
    repository paths. tools/release-drill-ai.sh copies this directory outside the checkout and restores it from a
    local feed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The release drill fails if this differs from the version it packs. -->
    <StarlingsVersion>0.2.0</StarlingsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings Starlings.Runtime.Onnx, .Acquisition and .Tokenizers at their pinned versions. -->
    <PackageReference Include="Starlings.Models.Gliner2" Version="$(StarlingsVersion)" />
    <!-- The application picks the ONNX Runtime natives (CPU here; Microsoft.ML.OnnxRuntime.Gpu.Linux for CUDA). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
